# Template. Copy to .env for local development (`netlify dev`, `npm run mail:verify`),
# and set the same keys in the Netlify UI under Site configuration →
# Environment variables for production.
#
# THIS FILE IS COMMITTED. .env is not. Real values belong in .env only —
# a password committed here goes to GitHub, and deleting it later does not
# remove it from the history.
#
# Nothing here reaches the browser: only netlify/functions/contact.mts reads
# these, and that runs on the server.

# Hostinger's outgoing mail server. If the domain is on Titan Email (Hostinger
# resells it on some plans) this is smtp.titan.email instead.
SMTP_HOST=smtp.hostinger.com

# 465 = implicit TLS (recommended). 587 = STARTTLS, if 465 is blocked.
SMTP_PORT=465

# The full mailbox address, used both to authenticate and as the From: header.
# Hostinger rejects a From: that is not the authenticated mailbox.
SMTP_USER=Sales@bmgt.ae

# The MAILBOX password — the one set on the email account in hPanel, which is
# not the same as the Hostinger account login. Leave blank here.
#
# ALWAYS SINGLE-QUOTE IT IN .env. Unquoted, every dotenv parser strips the '#'
# and everything after it as an inline comment, so the password arrives
# truncated and the server answers 535 — which looks exactly like a wrong
# password and is why `npm run mail:verify` checks for this.
#
#   SMTP_PASS='p@ss#word'      correct
#   SMTP_PASS=p@ss#word        silently becomes  p@ss
#
# The quotes are a .env file convention only. In the Netlify environment
# variable UI the value is taken literally — paste the bare password there, or
# the quotes become part of it.
SMTP_PASS=

# Where enquiries land. Defaults to SMTP_USER if unset. Comma-separate for more
# than one recipient.
CONTACT_TO=Sales@bmgt.ae
